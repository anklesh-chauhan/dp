{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "anklesh/ai-platform",
    "description": "Governed provider routing, failover, and observability for Laravel AI applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ai",
        "governance",
        "laravel",
        "llm"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^0.10"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Anklesh\\AiPlatform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anklesh\\AiPlatform\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anklesh\\AiPlatform\\AiPlatformServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "format": "pint --format agent",
        "test": "pest"
    }
}
